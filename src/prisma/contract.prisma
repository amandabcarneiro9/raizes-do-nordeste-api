// use prisma-8

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    String
  ativo     Boolean  @default(true)
  criadoEm  TimestamptzString @default(now())

  cliente   Cliente?
}

model Cliente {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  telefone  String?
  pontos    Int      @default(0)
  criadoEm  TimestamptzString @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}